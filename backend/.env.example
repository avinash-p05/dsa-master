# Optional local overrides for development. Copy to backend/.env (git-ignored).
# Spring Boot loads it automatically when you run ./mvnw spring-boot:run.

# Separate *development* GitHub OAuth app (GitHub allows one callback per app):
#   Homepage URL:  http://localhost:5173
#   Callback URL:  http://localhost:5173/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: add http://localhost:5173/login/oauth2/code/google as an extra
# redirect URI (and http://localhost:5173 as an origin) on your client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave unset to use Mailpit (http://localhost:8025). To send real mail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_FROM=DSA Master <you@gmail.com>
