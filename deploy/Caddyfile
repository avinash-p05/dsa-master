# HTTPS reverse proxy. Caddy obtains and renews the certificate for $DOMAIN
# automatically, so the domain's DNS A record must point at this server.
{$DOMAIN} {
	encode zstd gzip

	# Long-lived caching for fingerprinted build assets.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:8080
}
