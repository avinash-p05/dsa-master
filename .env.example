# Copy to .env on the server and fill in. Never commit .env.

# Public domain pointing at this server (needed for HTTPS, OAuth and email links).
DOMAIN=dsamaster.duckdns.org

# Host port the app listens on (127.0.0.1 only). Change if 8080 is taken.
APP_PORT=8080

# Strong random password, e.g. `openssl rand -base64 32`
DB_PASSWORD=change-me

# GitHub OAuth app (github.com/settings/developers)
#   Homepage URL:      https://<DOMAIN>
#   Callback URL:      https://<DOMAIN>/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
#   Authorised JavaScript origin: https://<DOMAIN>
#   Authorised redirect URI:      https://<DOMAIN>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for verification and password-reset emails (any provider).
# Gmail: smtp.gmail.com / 587, username = your Gmail address,
#        password = a 16-character App Password (Google Account > Security > App passwords; needs 2-Step Verification).
# Brevo: smtp-relay.brevo.com / 587, credentials from Brevo > SMTP & API.
# MAIL_FROM must be an address your SMTP account is allowed to send from.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=DSA Master <you@gmail.com>
