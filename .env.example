# Copy to .env on the server and fill in. Never commit .env.
# Release 1.0.1: GitHub sign-in only.

# Public domain pointing at this server (needed for HTTPS and OAuth).
DOMAIN=dsamaster.duckdns.org

# Password of the "dsamaster" role on the shared platform Postgres.
# Use letters/digits only, e.g. `openssl rand -hex 24`, then create the role with
#   APP_DB_PASSWORD=<this value> ~/platform/create-app-db.sh dsamaster
DB_PASSWORD=change-me

# GitHub OAuth app (github.com/settings/developers)
#   Homepage URL:   https://<DOMAIN>
#   Callback URL:   https://<DOMAIN>/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Optional, for later releases ----
# Google sign-in: fill both to show the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email/password sign-up (needs SMTP for verification emails).
# Gmail: smtp.gmail.com / 587 with a 16-character App Password; MAIL_FROM = the same Gmail address.
PASSWORD_LOGIN_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
